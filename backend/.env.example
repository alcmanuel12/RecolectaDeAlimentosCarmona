# Copia este archivo a .env y rellena los valores reales. Nunca subas .env al repositorio.

# Base de datos (PostgreSQL)
# DATABASE_URL: conexión con pooler (host "-pooler") para la app.
# DIRECT_URL: conexión directa (host sin "-pooler") para las migraciones de Prisma.
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:contraseña@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# JWT
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="12h"

# Servidor
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# SMTP (correo de agradecimiento). Con Gmail, usa una "contraseña de aplicación".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="contraseña-de-aplicacion"
SMTP_FROM="Hermandad <tu-cuenta@gmail.com>"

# Usuarios de prueba creados por el seed (npm run seed)
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD="12345678"
RECOLECTOR_EMAIL="usuario@usuario.com"
RECOLECTOR_PASSWORD="12345678"
